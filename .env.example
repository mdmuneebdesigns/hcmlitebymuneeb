# HCM Lite environment reference
#
# On Lovable Cloud these are provisioned automatically and injected at build/runtime.
# They are listed here only so anyone running the project elsewhere knows what is required.

# Browser-visible (Vite) configuration
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Server-only configuration (never expose these to the browser)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret>

# Lovable AI Gateway (server-side only; read by @lovable.dev/ai-gateway)
LOVABLE_API_KEY=<provided by the Lovable AI integration>
